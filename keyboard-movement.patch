diff --git a/src/controls/KeyboardMovementControls.ts b/src/controls/KeyboardMovementControls.ts
new file mode 100644
index 0000000..c458337
--- /dev/null
+++ b/src/controls/KeyboardMovementControls.ts
@@ -0,0 +1,91 @@
+import type { MovementAxes, MovementInput } from './MovementInput.ts'
+
+/** Physical key positions (event.code), so W·A·S·D work the same with a Korean keyboard layout. */
+const KEY_AXES: Readonly<Record<string, MovementAxes>> = {
+  KeyW: { forward: 1, right: 0 },
+  ArrowUp: { forward: 1, right: 0 },
+  KeyS: { forward: -1, right: 0 },
+  ArrowDown: { forward: -1, right: 0 },
+  KeyA: { forward: 0, right: -1 },
+  ArrowLeft: { forward: 0, right: -1 },
+  KeyD: { forward: 0, right: 1 },
+  ArrowRight: { forward: 0, right: 1 },
+}
+
+const SOURCE_ID = 'keyboard'
+
+/**
+ * Turns W·A·S·D and the arrow keys into walking input.
+ * Keys are ignored while someone is typing, while a menu has already used the key,
+ * and while the scene has paused visitor input behind a modal.
+ */
+export class KeyboardMovementControls {
+  private readonly input: MovementInput
+  private readonly isEnabled: () => boolean
+  private readonly pressed = new Set<string>()
+
+  constructor(input: MovementInput, isEnabled: () => boolean) {
+    this.input = input
+    this.isEnabled = isEnabled
+    window.addEventListener('keydown', this.onKeyDown)
+    window.addEventListener('keyup', this.onKeyUp)
+    window.addEventListener('blur', this.releaseAll)
+    document.addEventListener('visibilitychange', this.onVisibilityChange)
+  }
+
+  dispose(): void {
+    window.removeEventListener('keydown', this.onKeyDown)
+    window.removeEventListener('keyup', this.onKeyUp)
+    window.removeEventListener('blur', this.releaseAll)
+    document.removeEventListener('visibilitychange', this.onVisibilityChange)
+    this.releaseAll()
+  }
+
+  private readonly onKeyDown = (event: KeyboardEvent): void => {
+    if (!(event.code in KEY_AXES)) return
+    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return
+    if (isTypingTarget(event.target) || !this.isEnabled()) return
+
+    // Arrow keys would otherwise try to scroll the page or move focus.
+    event.preventDefault()
+    if (this.pressed.has(event.code)) return
+    this.pressed.add(event.code)
+    this.sync()
+  }
+
+  private readonly onKeyUp = (event: KeyboardEvent): void => {
+    if (this.pressed.delete(event.code)) this.sync()
+  }
+
+  /** A key released while the window was in the background never sends keyup, so forget everything. */
+  private readonly releaseAll = (): void => {
+    if (this.pressed.size === 0) return
+    this.pressed.clear()
+    this.sync()
+  }
+
+  private readonly onVisibilityChange = (): void => {
+    if (document.visibilityState === 'hidden') this.releaseAll()
+  }
+
+  private sync(): void {
+    let forward = 0
+    let right = 0
+    for (const code of this.pressed) {
+      forward += KEY_AXES[code].forward
+      right += KEY_AXES[code].right
+    }
+    // Opposite keys cancel out; each axis stays within -1..1 even if W and ArrowUp are both held.
+    this.input.set(SOURCE_ID, { forward: clampUnit(forward), right: clampUnit(right) })
+  }
+}
+
+function clampUnit(value: number): number {
+  return Math.max(-1, Math.min(1, value))
+}
+
+function isTypingTarget(target: EventTarget | null): boolean {
+  if (!(target instanceof HTMLElement)) return false
+  if (target.isContentEditable) return true
+  return target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement
+}
diff --git a/src/controls/MovementInput.ts b/src/controls/MovementInput.ts
new file mode 100644
index 0000000..c5e4030
--- /dev/null
+++ b/src/controls/MovementInput.ts
@@ -0,0 +1,45 @@
+/** Camera-relative walking intent: forward is away from the camera, right is screen-right. */
+export interface MovementAxes {
+  forward: number
+  right: number
+}
+
+const IDLE_AXES: MovementAxes = { forward: 0, right: 0 }
+
+/**
+ * Collects direct-walking input from every device in one place.
+ * The keyboard writes here today; a touch joystick can write here later without touching the scenes.
+ */
+export class MovementInput {
+  private readonly sources = new Map<string, MovementAxes>()
+
+  /** Each input device owns one named slot so releasing one device never cancels another. */
+  set(source: string, axes: MovementAxes): void {
+    if (axes.forward === 0 && axes.right === 0) {
+      this.sources.delete(source)
+      return
+    }
+    this.sources.set(source, axes)
+  }
+
+  clear(): void {
+    this.sources.clear()
+  }
+
+  /** Combined input, limited to length 1 so diagonals are not faster than straight lines. */
+  get axes(): MovementAxes {
+    if (this.sources.size === 0) return IDLE_AXES
+
+    let forward = 0
+    let right = 0
+    for (const axes of this.sources.values()) {
+      forward += axes.forward
+      right += axes.right
+    }
+
+    const length = Math.hypot(forward, right)
+    if (length === 0) return IDLE_AXES
+    const scale = length > 1 ? 1 / length : 1
+    return { forward: forward * scale, right: right * scale }
+  }
+}
